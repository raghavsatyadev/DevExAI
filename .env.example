# DevExAI secrets. Copy to .env next to settings.toml (installed: %LOCALAPPDATA%\DevExAI\data\.env).
# Never commit .env. Existing environment variables win over this file. Comments go on their own lines.

# Slack (docs/slack-app-manifest.yaml)
# App-Level Token (xapp-...), scope connections:write, for Socket Mode
SLACK_APP_TOKEN=
# Bot User OAuth Token (xoxb-...), shown after Install to Workspace
SLACK_BOT_TOKEN=

# Licence key for updates from our update server
DEVEXAI_LICENCE_KEY=
